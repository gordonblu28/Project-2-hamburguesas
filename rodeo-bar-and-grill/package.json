{
  "name": "rodeo-bar-and-grill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Website for The Rodeo Bar And Grill (Leon Valley, TX): static Astro site for Cloudflare.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/empaquetar.mjs",
    "preview": "astro preview",
    "imagenes": "node scripts/preparar-imagenes.mjs",
    "verificar": "node scripts/verificar-menu.mjs",
    "zip:codigo": "node scripts/empaquetar.mjs --codigo",
    "deploy:pages": "npx wrangler@4 pages deploy dist --project-name rodeo-bar-and-grill",
    "deploy:workers": "npx wrangler@4 deploy",
    "test": "node --test tests/*.test.ts",
    "test:integracion": "node --test --test-concurrency=1 tests/integracion/*.test.ts",
    "dev:worker": "npx wrangler@4 dev",
    "db:migrar": "npx wrangler@4 d1 migrations apply rodeo-reservaciones --remote"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/ultra": "5.3.0",
    "astro": "7.4.1",
    "gsap": "3.15.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
