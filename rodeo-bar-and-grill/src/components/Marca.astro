---
// Marca del sitio: el logo oficial de The Rodeo, a todo color (verde, amarillo, rojo y blanco,
// con los dos jinetes), en su versión horizontal sin el margen verde. Se ve igual sobre la
// cabecera clara, sobre el pie verde y sobre la noche de Halloween porque trae su propio fondo.
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo-horizontal.jpg';
import { NEGOCIO } from '../lib/datos';

interface Props {
  class?: string;
  /** Alto en px CSS en pantallas grandes (en el teléfono se reduce). */
  alto?: number;
  /** El enlace que la envuelve ya lleva el nombre: el texto alternativo sobraría. */
  decorativa?: boolean;
  prioridad?: boolean;
}
const { class: clase, alto = 56, decorativa = false, prioridad = true } = Astro.props;
const ancho = Math.round((alto * logo.width) / logo.height);
---

<span class:list={['marca', clase]} style={`--alto:${alto}px`}>
  <Image
    src={logo}
    alt={decorativa ? '' : `${NEGOCIO.nombre} logo`}
    widths={[ancho, ancho * 2, ancho * 3].map((n) => Math.min(n, logo.width))}
    sizes={`${ancho}px`}
    quality={84}
    loading={prioridad ? 'eager' : 'lazy'}
    decoding="async"
    class="marca__img"
  />
</span>

<style>
  .marca {
    display: inline-block;
    line-height: 0;
    border-radius: 8px;
    /* Filete claro: separa el verde del logo del fondo sin alterar sus colores. */
    box-shadow:
      0 0 0 1.5px rgb(255 255 255 / 0.7),
      0 6px 16px -8px rgb(1 49 33 / 0.6);
    transition: transform var(--t-base) var(--ease-buck);
  }

  .marca__img {
    display: block;
    height: calc(var(--alto) * 0.82);
    width: auto;
    max-width: none;
    border-radius: 8px;
  }

  @media (min-width: 900px) {
    .marca__img {
      height: var(--alto);
    }
  }
</style>
