---
// Íconos de línea dibujados para el sitio (24×24, trazo con currentColor).
export type NombreIcono =
  | 'casa'
  | 'menu'
  | 'estrella'
  | 'pin'
  | 'telefono'
  | 'instagram'
  | 'flecha'
  | 'flecha-izq'
  | 'cerrar'
  | 'buscar'
  | 'pausa'
  | 'play'
  | 'res'
  | 'margarita'
  | 'coctel'
  | 'cerveza'
  | 'botella'
  | 'refresco'
  | 'calabaza'
  | 'luna'
  | 'reloj'
  | 'mapa';

interface Props {
  nombre: NombreIcono;
  class?: string;
  titulo?: string;
}

const { nombre, class: clase, titulo } = Astro.props;

const trazos: Record<NombreIcono, string> = {
  casa: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 9.8V20h13V9.8"/><path d="M10 20v-5.5h4V20"/>',
  menu: '<path d="M6 3.5h12v17H6z"/><path d="M9 8h6M9 12h6M9 16h4"/>',
  estrella: '<path d="m12 3.2 2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.5l6.1-.7z"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.6A7 7 0 0 1 19 9.4C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.6"/>',
  telefono:
    '<path d="M6.6 3.5h3l1.6 4.4-2.1 1.5a12 12 0 0 0 5.5 5.5l1.5-2.1 4.4 1.6v3A2.1 2.1 0 0 1 18.3 19.5 15.6 15.6 0 0 1 4.5 5.7 2.1 2.1 0 0 1 6.6 3.5z"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6" fill="currentColor"/>',
  flecha: '<path d="M4 12h15"/><path d="m13.5 6 6 6-6 6"/>',
  'flecha-izq': '<path d="M20 12H5"/><path d="m10.5 6-6 6 6 6"/>',
  cerrar: '<path d="M6 6l12 12M18 6 6 18"/>',
  buscar: '<circle cx="10.5" cy="10.5" r="6.2"/><path d="m15.2 15.2 5 5"/>',
  pausa: '<path d="M8.5 5v14M15.5 5v14"/>',
  play: '<path d="M7 4.8v14.4L19 12z"/>',
  res: '<path d="M3 7c1.5 2.4 3.6 3 5 3h8c1.4 0 3.5-.6 5-3"/><path d="M8 10v4.2c0 3 1.8 5.3 4 5.3s4-2.3 4-5.3V10"/><path d="M10.4 16.3h.01M13.6 16.3h.01"/>',
  margarita: '<path d="M3.5 5h17l-7 7.5v6.5"/><path d="M3.5 5l7 7.5V19"/><path d="M8 21h8"/><circle cx="18.5" cy="5" r="2.4"/>',
  coctel: '<path d="M6 4h12l-1.4 15.2A2 2 0 0 1 14.6 21H9.4a2 2 0 0 1-2-1.8z"/><path d="M6.5 9.5h11"/><path d="M14 4l3-2.5"/>',
  cerveza: '<path d="M10 2.5h4v3l1.6 3.2V21H8.4V8.7L10 5.5z"/><path d="M8.4 12.5h7.2v5H8.4z"/>',
  botella: '<path d="M10.2 2.5h3.6v4.2c2.2 1 3.4 2.9 3.4 5.3V21H6.8v-9c0-2.4 1.2-4.3 3.4-5.3z"/><path d="M6.8 13.5h10.4"/>',
  refresco: '<path d="M6 7h12l-1.5 14h-9z"/><path d="M5 7h14"/><path d="m12 7 2.5-5"/>',
  calabaza:
    '<path d="M12 6.5c-4.8 0-8 3-8 7.2S7.2 21 12 21s8-3.1 8-7.3-3.2-7.2-8-7.2z"/><path d="M12 6.5c-1.6 1.8-1.6 12.7 0 14.5M12 6.5c1.6 1.8 1.6 12.7 0 14.5"/><path d="M12 6.5V3.5l2-1"/>',
  luna: '<path d="M19.6 14.6A8.2 8.2 0 1 1 9.4 4.4a6.6 6.6 0 0 0 10.2 10.2z"/>',
  reloj: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  mapa: '<path d="m3.5 6 5.5-2.5 6 2.5 5.5-2.5v14L15 20l-6-2.5-5.5 2.5z"/><path d="M9 3.5v14M15 6v14"/>',
};
---

<svg
  class:list={['icono', clase]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={titulo ? undefined : 'true'}
  role={titulo ? 'img' : undefined}
  aria-label={titulo}
  set:html={trazos[nombre]}
/>
