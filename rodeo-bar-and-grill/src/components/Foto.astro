---
// Foto de un platillo en un rectángulo de esquinas redondeadas (reemplaza los medallones
// redondos y los arcos). Las fotos son recortes cuadrados del menú impreso que traen el rótulo
// del plato abajo: el encuadre apaisado y centrado arriba lo deja fuera.
// Sin foto muestra un azulejo de talavera con el ícono (y el número del plato, si lo hay):
// nunca una foto de otro plato.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icono, { type NombreIcono } from './Icono.astro';
import { ladoMaximo } from '../lib/menu';

interface Props {
  img?: ImageMetadata;
  alt?: string;
  /** Ancho máximo en px CSS al que se mostrará (para elegir la resolución). */
  ancho: number;
  /** Alto / ancho del marco (0.75 = 4:3 apaisado). */
  proporcion?: number;
  prioridad?: boolean;
  /** Ícono del azulejo cuando no hay foto. */
  icono?: NombreIcono;
  /** Texto del azulejo cuando no hay foto (por ejemplo, "No. 12"). */
  marca?: string;
  /** Más fotos apiladas en el mismo marco (el inicio las alterna). */
  alternas?: { img: ImageMetadata; alt: string }[];
  /** No crece más de lo que permite la resolución de la foto (fotos grandes y solitarias). */
  limitar?: boolean;
  class?: string;
}

const { img, alt = '', ancho, proporcion = 0.75, prioridad = false, icono = 'estrella', marca, alternas = [], limitar = false, class: clase } = Astro.props;
// Un poco más que ladoMaximo: el encuadre apaisado recorta los lados de la foto cuadrada.
const maximo = img && limitar ? `;max-width:${Math.max(220, Math.round(ladoMaximo(img) * 1.25))}px` : '';
const anchos = (i: ImageMetadata) => [...new Set([ancho, ancho * 2].map((n) => Math.min(Math.round(n), i.width)))];
---

<figure class:list={['foto', clase, { 'foto--azulejo': !img }]} style={`--proporcion:${proporcion}${maximo}`}>
  {
    img ? (
      <>
        <Image
          src={img}
          alt={alt}
          widths={anchos(img)}
          sizes={`${ancho}px`}
          quality={82}
          loading={prioridad ? 'eager' : 'lazy'}
          fetchpriority={prioridad ? 'high' : 'auto'}
          decoding="async"
          data-activa
        />
        {alternas.map((a) => (
          <Image src={a.img} alt={a.alt} widths={anchos(a.img)} sizes={`${ancho}px`} quality={82} loading="lazy" decoding="async" class="foto__alterna" />
        ))}
      </>
    ) : (
      <div class="foto__azulejo talavera" role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
        <span class="foto__insignia">
          <Icono nombre={icono} />
          {marca && <span>{marca}</span>}
        </span>
      </div>
    )
  }
  <slot />
</figure>

<style>
  .foto {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / var(--proporcion);
    margin: 0;
    overflow: hidden;
    border-radius: var(--radio-foto);
    background: var(--c-carbon);
    /* Las esquinas recortan también la foto que crece al pasar el cursor (Safari). */
    isolation: isolate;
  }

  .foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    filter: saturate(1.08) contrast(1.04);
    transition: transform 0.9s var(--ease-out);
  }

  .foto :global(.foto__alterna) {
    visibility: hidden;
  }

  /* Brillo suave arriba y trama fina: dan cuerpo a las fotos de baja resolución. */
  .foto::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.16), transparent 42%),
      radial-gradient(rgb(0 0 0 / 0.16) 0.6px, transparent 0.9px) 0 0 / 3px 3px;
    box-shadow: inset 0 0 0 1px rgb(20 18 15 / 0.12);
  }

  .foto--azulejo {
    background: none;
  }

  .foto__azulejo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  /* Placa blanca al centro del azulejo, con el ícono y el número del plato. */
  .foto__insignia {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 12px 16px 10px;
    border-radius: 12px;
    background: var(--c-blanco);
    box-shadow:
      0 0 0 1.5px var(--c-verde),
      0 0 0 5px var(--c-blanco),
      0 0 0 6.5px var(--c-rojo);
    color: var(--c-verde);
  }

  .foto__insignia :global(svg) {
    width: 30px;
    height: 30px;
    stroke-width: 1.6;
  }

  .foto__insignia > span {
    font-family: var(--f-label);
    font-weight: 700;
    font-size: 0.86rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-negro);
    white-space: nowrap;
  }
</style>
