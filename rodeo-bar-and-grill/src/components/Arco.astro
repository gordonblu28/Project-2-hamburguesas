---
// Foto real enmarcada en un arco de misión (el motivo de las misiones de San Antonio y de El
// Álamo), con doble filete como las ventanas de los letreros. Nunca se muestra más grande de lo
// que permite su resolución: si el arco pedido es mayor, se reduce.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ladoMaximo } from '../lib/menu';

interface Props {
  img: ImageMetadata;
  alt: string;
  /** Ancho deseado en px CSS. */
  ancho: number;
  /** Alto / ancho del arco. */
  proporcion?: number;
  /** Desplazamiento de la foto dentro del arco al desplazarse la página (0 = sin profundidad). */
  profundidad?: number;
  /** Parte inferior de la foto que queda fuera del arco: los recortes del menú impreso traen
   *  ahí el rótulo del plato. */
  recorte?: number;
  prioridad?: boolean;
  class?: string;
}

const { img, alt, ancho, proporcion = 1.25, profundidad = 0.05, recorte = 0.16, prioridad = false, class: clase } = Astro.props;
// Con profundidad, la foto sobra 7 % arriba y abajo para desplazarse sin dejar bordes vacíos.
const margen = profundidad ? 0.07 : 0;
const sobra = (1 + recorte) * (1 + margen * 2);
const altoPedido = ancho * proporcion;
const escala = Math.min(1, ladoMaximo(img) / (altoPedido * sobra));
const w = Math.round(ancho * escala);
const h = Math.round(altoPedido * escala);
const lado = Math.round(h * sobra);
---

<figure class:list={['arco', clase]} style={`--w:${w}px;--proporcion:${w} / ${h};--sobra:${sobra.toFixed(3)};--margen:${margen}`}>
  <div class="arco__marco" data-revela="arco">
    <div class="arco__foto" data-paralaje={profundidad || undefined}>
      <Image
        src={img}
        alt={alt}
        widths={[...new Set([lado, Math.min(img.width, lado * 2)])]}
        sizes={`${lado}px`}
        quality={80}
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
  </div>
  <slot />
</figure>

<style>
  .arco {
    width: min(var(--w), 100%);
    margin: 0;
  }

  .arco__marco {
    position: relative;
    aspect-ratio: var(--proporcion);
    overflow: hidden;
    /* Radios enormes: el navegador los reduce a medio ancho y el tope queda en medio punto. */
    border-radius: 999px 999px 2px 2px;
    background: var(--c-carbon);
    box-shadow:
      0 0 0 5px var(--fondo),
      0 0 0 6px var(--linea-fuerte);
    margin: 6px;
  }

  /* La foto es más alta que el arco: lo que sobra abajo (el rótulo impreso) queda oculto. */
  .arco__foto {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--margen) * -100%);
    height: calc(var(--sobra) * 100%);
  }

  .arco__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 1.1s var(--ease-out);
  }

  @media (hover: hover) {
    .arco:hover .arco__foto :global(img),
    :global(a:hover) > .arco .arco__foto :global(img) {
      transform: scale(1.05);
    }
  }
</style>
