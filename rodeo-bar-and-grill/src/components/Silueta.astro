---
// Silueta del jinete del logo (scripts/preparar-imagenes.mjs la separa del JPG). Se pinta como
// máscara con el color del texto: negro sobre beige, beige sobre negro, carbón contra la luna de
// Halloween. Es decorativa: los lectores de pantalla no la anuncian.
// La clase se aplica al envoltorio, así admite bordes (la línea de suelo) que la máscara no recorta.
// El PNG se sirve tal cual (13 KB, alfa limpio): reconvertirlo con paleta tramaba la transparencia.
import siluetaUrl from '../assets/marca/jinete-silueta.png?url';
import silueta from '../assets/marca/jinete-silueta.png';

interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
---

<span class:list={['silueta', clase]} aria-hidden="true">
  <span class="silueta__forma" style={`--silueta:url("${siluetaUrl}");--proporcion:${silueta.width} / ${silueta.height}`}></span>
</span>

<style>
  .silueta {
    display: block;
  }

  .silueta__forma {
    display: block;
    aspect-ratio: var(--proporcion);
    background: currentColor;
    -webkit-mask: var(--silueta) center / contain no-repeat;
    mask: var(--silueta) center / contain no-repeat;
  }
</style>
