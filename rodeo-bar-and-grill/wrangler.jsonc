// Cloudflare Worker: sirve el sitio estático (dist/) y la API de reservaciones (worker/index.ts).
// Publicar: npm run build && npm run deploy:workers
// Primera vez (ver "Reservaciones" en README.md):
//   1. npx wrangler@4 d1 create rodeo-reservaciones   → copie el database_id de abajo
//   2. npx wrangler@4 d1 migrations apply rodeo-reservaciones --remote
//   3. npx wrangler@4 secret put STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / ADMIN_TOKEN
{
  "name": "rodeo-bar-and-grill",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Solo /api/ pasa por el Worker; el resto se sirve directo (rápido y sin costo de Worker).
    "run_worker_first": ["/api/*"],
    // /menu y /menu/ abren /menu/index.html
    "html_handling": "auto-trailing-slash",
    // Las rutas que no existen muestran dist/404.html con estado 404
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rodeo-reservaciones",
      // PENDIENTE: el identificador que da `wrangler d1 create rodeo-reservaciones`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Los archivos de src/data/*.yaml se leen como texto (la configuración de reservaciones).
  "rules": [{ "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true }],
  "observability": { "enabled": true }
}
