# Public base URL used for canonical URLs, sitemap, Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (optional) ---------------------------------------------------
# When STRIPE_SECRET_KEY is set AND config/restaurant.ts -> payments.online.provider
# is "stripe", online card payments use Stripe Checkout. Without it, online payment
# is shown as unavailable (demo mode never pretends a card was charged).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Orders storage --------------------------------------------------------
# "file" (default, dev only): orders are written to ./.data/orders.json on this machine.
# Nothing is transmitted to the restaurant. See lib/orders/repository.ts to add Postgres/Supabase.
ORDER_STORE=file
